#Brute Force 
# Time Complexity : O(N^2)
#Space Complexity : O(N)
class Solution:
    def check(self, nums: List[int]) -> bool:
        asc = nums[:]
        asc.sort()
        buffer = False
        for i in range(len(nums)):
            if nums != asc:
                x = asc.pop(-1)
                asc.insert(0 , x)
            else:
                buffer = True
        return  buffer
    
#Optimal
#Time Complexity : O(N)
#Space Compexity : O(1)
class Solution:
    def check(self, nums: List[int]) -> bool:
        counter = 0
        for i in range(len(nums)-1):
            if nums[i] > nums[i+1]:
                counter += 1
        if nums[len(nums)-1] > nums[0]:
            counter += 1
        
        if counter <= 1:
            return True
        else:
            return False
